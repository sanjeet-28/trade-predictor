# ==============================================================================
# Environment Secrets Template
# Copy this file to .env and fill in your actual credentials.
# Never commit the .env file to Git!
# ==============================================================================

# Telegram Bot API token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Primary Telegram chat ID (numerical) to receive "TRADE IS ACTIVE!" notifications
TELEGRAM_CHAT_ID=987654321

# Optional separate Telegram chat ID for system health alerts (stream drop, freeze, etc.)
# If left empty, system health alerts will be delivered to TELEGRAM_CHAT_ID
TELEGRAM_HEALTH_CHAT_ID=

# Optional overrides for stream URLs (defaults will be loaded from config.yaml if empty)
STREAM_PRIMARY_URL=
STREAM_CHANNEL_URL=

